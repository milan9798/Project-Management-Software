generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique(map: "token_hash") @db.Char(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_user")

  @@index([user_id], map: "idx_reset_user_id")
}

model users {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  email                 String                  @unique(map: "email") @db.VarChar(150)
  password              String                  @db.VarChar(255)
  role                  users_role              @default(master_admin)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  password_reset_tokens password_reset_tokens[]
}

enum users_role {
  master_admin
}

model Project {
  id              Int      @id @default(autoincrement())
  projectCode     String   @unique @db.VarChar(50)
  projectName     String   @db.VarChar(200)
  customerName    String   @db.VarChar(200)
  workOrderNumber String?  @db.VarChar(100)
  projectType     String   @db.VarChar(100)
  orderValue      Decimal  @default(0) @db.Decimal(15, 2)
  startDate       DateTime?
  deliveryDate    DateTime?
  priority        String   @default("MEDIUM") @db.VarChar(20)
  status          String   @default("PLANNING") @db.VarChar(30)
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([deliveryDate])
}



model Revenue {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique @db.VarChar(100)
  invoiceDate   DateTime @db.Date
  customerName  String   @db.VarChar(200)
  projectCode   String?  @db.VarChar(50)
  amount        Decimal  @db.Decimal(15, 2)
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([invoiceDate])
  @@index([projectCode])
}

model Expense {
  id             Int      @id @default(autoincrement())
  voucherNumber  String   @unique @db.VarChar(100)
  expenseDate    DateTime @db.Date
  category       String   @db.VarChar(100)
  projectCode    String?  @db.VarChar(50)
  amount         Decimal  @db.Decimal(15, 2)
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expenseDate])
  @@index([projectCode])
}
