generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique(map: "token_hash") @db.Char(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_user")

  @@index([user_id], map: "idx_reset_user_id")
}

model users {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  email                 String                  @unique(map: "email") @db.VarChar(150)
  password              String                  @db.VarChar(255)
  role                  users_role              @default(master_admin)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  password_reset_tokens password_reset_tokens[]
}

enum users_role {
  master_admin
}
